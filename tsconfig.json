{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"typeRoots": ["./node_modules/@types"],
		"types": ["node"]
	},
	"include": ["*.ts", "scripts/*.ts"]
}
